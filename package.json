{
  "name": "wispr-max",
  "version": "0.7.14",
  "description": "Wispr Flow, maxed out: voice dictation plus an AI writer that types into any app.",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron .",
    "start": "electron .",
    "watch": "node scripts/build.mjs --watch",
    "build:web": "node scripts/build-web.mjs",
    "web": "node scripts/build-web.mjs && tsx scripts/serve-web.mts",
    "typecheck": "tsc",
    "test": "tsx --test test/*.test.ts",
    "icons": "tsx scripts/icons.mts",
    "dist": "npm run build && electron-builder",
    "eval": "tsx scripts/eval.mts",
    "release": "npm run build && electron-builder --publish always"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "electron-updater": "^6.8.11",
    "piixpal": "^0.4.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "html-to-image": "^1.11.13",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.wisprmax.app",
    "productName": "Wispr Max",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Wispr Max listens while you hold the hotkey so it can type what you say.",
        "NSAppleEventsUsageDescription": "Wispr Max uses System Events to paste text into the app you are typing in."
      },
      "artifactName": "Wispr-Max-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "assets/icon.png",
      "target": "nsis",
      "artifactName": "Wispr-Max-Setup-${version}.${ext}"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": "AppImage",
      "category": "Utility",
      "artifactName": "Wispr-Max-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Iamritupatil",
        "repo": "wispr-max",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "npmRebuild": false
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Iamritupatil/wispr-max.git"
  },
  "homepage": "https://github.com/Iamritupatil/wispr-max",
  "author": "Ritu Patil"
}
